# Clerk publishable key (Clerk dashboard -> API keys). Without it the public booking pages still work
# but the manager dashboard shows a "Clerk is not configured" notice.
VITE_CLERK_PUBLISHABLE_KEY=

# Leave blank in dev (Vite proxies /api to http://localhost:8080).
# In production, set to the API's public URL including /api, e.g. https://api.example.com/api
VITE_API_URL=

# ISO 4217 code used to display prices. The schema has no per-business currency yet.
VITE_CURRENCY=CAD
