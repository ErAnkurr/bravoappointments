# Used by docker-compose.yml (the "full" profile) and as a reference for the variables the API reads.
# Copy to .env. Never commit .env.

# --- Clerk (manager sign-in). Leave blank to run public booking only. ---
# Issuer = your Clerk Frontend API URL, e.g. https://your-app.clerk.accounts.dev
CLERK_ISSUER=
# JWKS URL = <issuer>/.well-known/jwks.json
CLERK_JWKS_URL=

# --- Email (Resend). Leave blank and emails are logged instead of sent. ---
RESEND_API_KEY=
EMAIL_FROM=Bravo Appointments <onboarding@resend.dev>

# --- URLs ---
# Where the React app is served (used in email links and CORS).
PUBLIC_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database (production). Local dev defaults match docker-compose. ---
# Runtime: pooled connection. Supabase transaction pooler needs ?prepareThreshold=0
# DATABASE_URL=jdbc:postgresql://<pooler-host>:6543/postgres?prepareThreshold=0
# Migrations: direct (non-pooled) connection.
# DATABASE_DIRECT_URL=jdbc:postgresql://<direct-host>:5432/postgres
# DATABASE_USER=
# DATABASE_PASSWORD=
